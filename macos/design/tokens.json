{
  "$description": "Canonical design tokens for the ai-usage macOS app. Transcribed from accepted handoff 0.1.1 (app/styles.css :root). Edit here, then run `make design-build`.",
  "color": {
    "semantic": {
      "background": {
        "$type": "color",
        "$value": "#f7f7f8",
        "$description": "Popover and window background (--au-bg)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#242527"
          }
        }
      },
      "panel": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards and panels (--au-panel)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#303134"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#202124",
        "$description": "Primary text (--au-text)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#f1f2f3"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#5f6268",
        "$description": "Secondary text (--au-muted)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#b1b4bc"
          }
        }
      },
      "line": {
        "$type": "color",
        "$value": "#dedfe2",
        "$description": "Hairline borders (--au-line)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#45464b"
          }
        }
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#c9cbd0",
        "$description": "Emphasized borders (--au-line-strong)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#5a5c62"
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": "#edf0f4",
        "$description": "Hover fill (--au-hover)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#3b3d42"
          }
        }
      },
      "track": {
        "$type": "color",
        "$value": "#e6e8ec",
        "$description": "Meter track (--au-track)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#43454a"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#2e6cba",
        "$description": "Accent, input bars, links (--au-blue)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#78aff4"
          }
        }
      },
      "accentSoft": {
        "$type": "color",
        "$value": "#a9c3e6",
        "$description": "Output bars, secondary series (--au-blue-soft)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#3d5a80"
          }
        }
      },
      "accentBackground": {
        "$type": "color",
        "$value": "#e8f0fb",
        "$description": "Selected and today fill (--au-blue-bg)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#26354a"
          }
        }
      },
      "success": {
        "$type": "color",
        "$value": "#286f3d",
        "$description": "Healthy status (--au-green)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#86c999"
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#7d520f",
        "$description": "Limits and stale readings (--au-amber)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#e7bc70"
          }
        }
      },
      "warningBackground": {
        "$type": "color",
        "$value": "#fff4dd",
        "$description": "Warning notice fill (--au-amber-bg)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#3e3423"
          }
        }
      },
      "danger": {
        "$type": "color",
        "$value": "#b3261e",
        "$description": "Failures (--au-red)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#f2a49c"
          }
        }
      },
      "dangerBackground": {
        "$type": "color",
        "$value": "#fdecea",
        "$description": "Failure notice fill (--au-red-bg)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#45292a"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#2e6cba",
        "$description": "Focus ring (--au-focus)",
        "$extensions": {
          "codes.porta.appearance": {
            "dark": "#8fbdf7"
          }
        }
      }
    },
    "component": {
      "card": {
        "background": {
          "$type": "color",
          "$value": "{color.semantic.panel}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.semantic.line}"
        }
      },
      "chart": {
        "input": {
          "$type": "color",
          "$value": "{color.semantic.accent}"
        },
        "output": {
          "$type": "color",
          "$value": "{color.semantic.accentSoft}"
        },
        "today": {
          "$type": "color",
          "$value": "{color.semantic.accentBackground}"
        },
        "stale": {
          "$type": "color",
          "$value": "{color.semantic.warning}"
        },
        "notCollected": {
          "$type": "color",
          "$value": "{color.semantic.track}"
        }
      },
      "meter": {
        "fill": {
          "$type": "color",
          "$value": "{color.semantic.accent}"
        },
        "track": {
          "$type": "color",
          "$value": "{color.semantic.track}"
        },
        "warning": {
          "$type": "color",
          "$value": "{color.semantic.warning}"
        }
      }
    }
  },
  "font": {
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "pt"
        },
        "$description": "Captions, axis labels at card scale (--fs-caption)"
      },
      "chart": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "pt"
        },
        "$description": "Minimum chart text (handoff \u00a78: at least 11 pt)"
      },
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "pt"
        },
        "$description": "Body (--fs-body)"
      },
      "lead": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "pt"
        },
        "$description": "Card headings (--fs-lead)"
      },
      "title": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "pt"
        },
        "$description": "Popover title (--fs-title)"
      },
      "figure": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "pt"
        },
        "$description": "Large figures (--fs-figure)"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "pt"
      },
      "$description": "--sp-1"
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "pt"
      },
      "$description": "--sp-2"
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "pt"
      },
      "$description": "--sp-3"
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "pt"
      },
      "$description": "--sp-4"
    },
    "5": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "pt"
      },
      "$description": "--sp-5"
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "pt"
      },
      "$description": "--sp-6"
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "pt"
      },
      "$description": "--sp-8"
    }
  },
  "radius": {
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "pt"
      },
      "$description": "--r-sm"
    },
    "medium": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "pt"
      },
      "$description": "--r-md"
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "pt"
      },
      "$description": "--r-card"
    },
    "popover": {
      "$type": "dimension",
      "$value": {
        "value": 15,
        "unit": "pt"
      },
      "$description": "--r-pop"
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "medium": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    }
  },
  "layout": {
    "popoverWidth": {
      "$type": "dimension",
      "$value": {
        "value": 420,
        "unit": "pt"
      },
      "$description": "Popover width (--pop-width)"
    },
    "popoverMaxHeight": {
      "$type": "dimension",
      "$value": {
        "value": 780,
        "unit": "pt"
      },
      "$description": "Popover max height: min(780, screen - 96)"
    },
    "popoverScreenMargin": {
      "$type": "dimension",
      "$value": {
        "value": 96,
        "unit": "pt"
      },
      "$description": "Vertical screen margin subtracted from the popover height bound"
    },
    "historyMinWidth": {
      "$type": "dimension",
      "$value": {
        "value": 640,
        "unit": "pt"
      },
      "$description": "History window minimum width"
    },
    "historyMinHeight": {
      "$type": "dimension",
      "$value": {
        "value": 460,
        "unit": "pt"
      },
      "$description": "History window minimum height"
    }
  }
}
