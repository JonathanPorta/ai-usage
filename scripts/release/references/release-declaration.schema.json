{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blessed-cicd/schemas/release/v1",
  "title": "blessed/release/v1",
  "description": "The producer's repo-local release declaration (releases.pipeline@1). It describes the release PIPELINE \u2014 how a candidate is minted, signed, and where (if anywhere) it is handed off \u2014 not product truth. `distribution` names the publish shape: omitted or `surfaces` means the candidate is handed to one or more downstream surfaces, which must be declared; `candidate-only` means the producer publishes a candidate to its own candidate store and nothing is promoted anywhere. Candidate-only is a narrower claim, never a relaxation: the manifest signature stays required.",
  "type": "object",
  "$defs": {
    "safeBasename": {
      "description": "Basename only \u2014 no path separators, no traversal, no leading dot.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "surface": {
      "type": "object",
      "required": [
        "id",
        "owner_repo",
        "kind",
        "publisher_model"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "owner_repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "public-download-surface",
            "runtime-artifact-surface",
            "public-github-mirror",
            "registry-store-surface",
            "product-release-bom",
            "package-repository-surface"
          ]
        },
        "publisher_model": {
          "type": "string",
          "enum": [
            "surface-pull",
            "producer-push",
            "producer-push-pr"
          ]
        }
      },
      "description": "One downstream surface this producer hands a candidate to. `kind` fixes which publisher models are admissible: a surface another repo owns is always surface-pull, the producer-owned registry store is the gated producer-push exception, and only a public GitHub mirror may be producer-push-pr (publish-surfaces.core). releases.surfaces@1's executable v1 admits surface-pull ALONE in the SURFACE owner's own declaration; this producer-side schema additionally recognizes the two models releases.pipeline@1 defines in prose, and never widens what that validator accepts.",
      "allOf": [
        {
          "description": "A surface owned by another repo is ingested and published by its owner; a producer never holds its publication authority.",
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "public-download-surface",
                  "runtime-artifact-surface",
                  "product-release-bom",
                  "package-repository-surface"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "publisher_model": {
                "const": "surface-pull"
              }
            }
          }
        },
        {
          "description": "The producer-owned registry store is the one surface whose gated publish IS the live promotion.",
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "registry-store-surface"
              }
            }
          },
          "then": {
            "properties": {
              "publisher_model": {
                "const": "producer-push"
              }
            }
          }
        },
        {
          "description": "A public GitHub mirror may be pulled by its owner or pushed as a reviewed PR; producer-push is never automatic.",
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "public-github-mirror"
              }
            }
          },
          "then": {
            "properties": {
              "publisher_model": {
                "enum": [
                  "surface-pull",
                  "producer-push-pr"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "project",
    "component",
    "versioning",
    "candidate"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "blessed/release/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "versioning": {
      "type": "string",
      "enum": [
        "semver"
      ]
    },
    "distribution": {
      "description": "Publish shape. Omitted is equivalent to `surfaces` so existing declarations stay valid.",
      "type": "string",
      "enum": [
        "surfaces",
        "candidate-only"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "store",
        "trigger",
        "manifest_schema",
        "public_notes",
        "signing"
      ],
      "additionalProperties": false,
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "github-release"
          ]
        },
        "trigger": {
          "type": "string",
          "enum": [
            "release-branch",
            "tag",
            "manual"
          ]
        },
        "manifest_schema": {
          "const": "blessed/release-candidate/v1"
        },
        "public_notes": {
          "$ref": "#/$defs/safeBasename"
        },
        "signing": {
          "type": "object",
          "required": [
            "manifest",
            "artifacts",
            "profile",
            "key_id"
          ],
          "additionalProperties": false,
          "properties": {
            "manifest": {
              "description": "Always `required` in v1: every published candidate carries a manifest signature, whether or not a surface later promotes it.",
              "const": "required"
            },
            "artifacts": {
              "type": "string",
              "enum": [
                "required",
                "optional"
              ]
            },
            "profile": {
              "const": "ed25519-detached-v1"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "workflow": {
      "description": "Inputs to the GENERATED release workflow (releases.release-pr@1 RP-9): product values only. The procedure, its jobs, Environments, permissions, credential handling and publication come from the pinned release category's template, never from here. scripts/release/render-workflows.sh renders .github/workflows/release.yml from this block and blessed.yml; scripts/release/check-conformance.sh fails when the committed file differs.",
      "type": "object",
      "required": [
        "cells",
        "required_artifacts",
        "signing_key_encoding"
      ],
      "additionalProperties": false,
      "properties": {
        "setup_action": {
          "description": "true: every product job first runs the repository's own composite action .github/actions/release-setup (toolchains only; it may not load secrets).",
          "type": "boolean"
        },
        "cells": {
          "description": "The build matrix: each cell runs `make release-build` on its runner with no secret and writes its outputs and their artifacts.json.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "runner"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "runner": {
                "type": "string",
                "enum": [
                  "ubuntu-24.04",
                  "ubuntu-24.04-arm",
                  "ubuntu-latest",
                  "macos-15",
                  "macos-latest",
                  "windows-2025",
                  "windows-latest"
                ]
              }
            }
          }
        },
        "required_artifacts": {
          "description": "What a release MUST contain, by (platform, install_kind): a build that silently drops one is refused before any key is used.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "install_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": "string",
                "pattern": "^(any|[a-z0-9]+/[a-z0-9_]+)$"
              },
              "install_kind": {
                "type": "string",
                "enum": [
                  "binary",
                  "tarball",
                  "appimage",
                  "dmg",
                  "msi",
                  "exe",
                  "rpm",
                  "deb",
                  "archive",
                  "image",
                  "other"
                ]
              }
            }
          }
        },
        "rpm": {
          "description": "Present iff the release contains RPMs: native finalization (linux-packaging LP-9) with the rpm-signing domain's key.",
          "type": "object",
          "required": [
            "public_key",
            "fingerprint_file"
          ],
          "additionalProperties": false,
          "properties": {
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
              "description": "Repository-relative path; no traversal, no leading dot or slash."
            },
            "fingerprint_file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
              "description": "Repository-relative path; no traversal, no leading dot or slash."
            }
          }
        },
        "signing_key_encoding": {
          "description": "How the release-signing domain stores the candidate key: an Ed25519 PKCS#8 PEM, or the base64 64-byte seed||public form (scripts/signing/sign.sh --private-key-encoding).",
          "type": "string",
          "enum": [
            "pkcs8-pem",
            "ed25519-seed-public-base64"
          ]
        },
        "derive": {
          "description": "true: after every artifact is signed, `make release-derive` (no secret) may ADD planned files derived from the signed set (e.g. an updater index); it may not change any existing file.",
          "type": "boolean"
        },
        "verify": {
          "description": "true: after the candidate is signed and validated, `make release-verify` (no secret) runs a product check against it before publication.",
          "type": "boolean"
        },
        "lifecycle": {
          "description": "linux-packaging LP-6: the publication gate. Each row runs `make release-lifecycle` with no secret on the FINAL candidate bytes (after RPM finalization and signing, validated against the committed trust store) and on the previous published release (validated the same way), in a secret-free job; publication requires a passing result for EVERY row, bound to this candidate's manifest. Every required deb/rpm artifact is either a row or listed under build_only.",
          "type": "object",
          "required": [
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "artifact",
                  "platform",
                  "evidence",
                  "proves"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                  },
                  "artifact": {
                    "type": "object",
                    "required": [
                      "platform",
                      "install_kind"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "platform": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+/[a-z0-9_]+$"
                      },
                      "install_kind": {
                        "type": "string",
                        "enum": [
                          "deb",
                          "rpm",
                          "tarball"
                        ]
                      }
                    }
                  },
                  "platform": {
                    "description": "The container platform the row's system under test runs on.",
                    "type": "string",
                    "enum": [
                      "linux/amd64",
                      "linux/arm64",
                      "linux/arm/v7"
                    ]
                  },
                  "evidence": {
                    "description": "LP-1 evidence level: native (the runner's own CPU) or emulated (QEMU user emulation on the x86_64 runner).",
                    "type": "string",
                    "enum": [
                      "native",
                      "emulated"
                    ]
                  },
                  "proves": {
                    "description": "LP-6 steps the product's test must report proven for this row (evidence.json). install, upgrade, function and remove are always required.",
                    "type": "array",
                    "minItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "install",
                        "upgrade",
                        "function",
                        "remove",
                        "config",
                        "state",
                        "purge",
                        "ownership",
                        "signature"
                      ]
                    }
                  }
                }
              }
            },
            "build_only": {
              "description": "Required deb/rpm artifacts that are built but NOT supported (LP-1 build-only): no lifecycle row, never described as supported.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "platform",
                  "install_kind"
                ],
                "additionalProperties": false,
                "properties": {
                  "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+/[a-z0-9_]+$"
                  },
                  "install_kind": {
                    "type": "string",
                    "enum": [
                      "deb",
                      "rpm",
                      "tarball"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "distribution"
        ],
        "properties": {
          "distribution": {
            "const": "candidate-only"
          }
        }
      },
      "then": {
        "description": "Candidate-only: no downstream surface exists, so none may be declared.",
        "properties": {
          "surfaces": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "description": "Surface hand-off (the default): at least one surface owns where the bytes go.",
        "required": [
          "surfaces"
        ],
        "properties": {
          "surfaces": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
