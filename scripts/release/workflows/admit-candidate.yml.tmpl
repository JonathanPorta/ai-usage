#@ The canonical surface admission workflow (releases.release-pr@1 RP-9;
#@ package-repositories PR-2/PR-3). Rendered by render-workflows.sh from
#@ release-surfaces.yaml and blessed.yml.
# GENERATED by blessed-cicd scripts/release/render-workflows.sh (release-v@@RELEASE_VERSION@@)
# from release-surfaces.yaml and blessed.yml. DO NOT EDIT: change those
# declarations and run `bash scripts/release/render-workflows.sh`;
# scripts/release/check-conformance.sh fails required CI on any difference.
name: Admit candidate

# An operator names a producer and a published tag. This workflow fetches that
# release's COMPLETE asset set with the read-only candidate credential, admits
# it against this repository's committed trust store and policy (the surface's
# own `make admit-candidate`, offline, no secret), and proposes the admitted
# inventory as a REVIEWED PR. Merging that PR is the approval.
#
#   fetch    Environment candidate-ingest: the producer read token only
#   admit    no secret: `make admit-candidate`; its inventory leaves only as
#            an artifact
#   open-pr  Environment admission-pr: this repository's admission-PR App key
#            only (RP-6/RP-7). Its token is minted for this repository; the
#            branch, its one commit and the PR are made through the API, so
#            no admission code runs where the key is.
#
# The PR is opened by the App, not GITHUB_TOKEN, so the required checks start
# on their own; the App never reviews and is no bypass actor.

on:
  workflow_dispatch:
    inputs:
      producer_repo:
        description: 'The producer repository'
        required: true
        type: choice
        options:
#@producers
      tag:
        description: 'The release tag to admit (vX.Y.Z)'
        required: true
        type: string

permissions: {}

concurrency:
  group: admit-${{ inputs.producer_repo }}-${{ inputs.tag }}
  cancel-in-progress: false

jobs:
  fetch:
    name: 🔐 fetch the published candidate (candidate read token only)
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: candidate-ingest
    permissions:
      contents: read
    steps:
      - name: 🔒 main only
        run: |
          set -euo pipefail
          [ "$GITHUB_REF" = refs/heads/main ] || { echo "::error::admission runs from main only, not $GITHUB_REF"; exit 1; }
      - name: Check out the secret loader and the blessed scripts only
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
          sparse-checkout: |
            .github/actions/load-secrets
            scripts/bws
            scripts/release
          sparse-checkout-cone-mode: false
      - name: 🚦 Inputs, and the read token is provisioned (before any secret)
        env:
          TAG: ${{ inputs.tag }}
        run: |
          set -euo pipefail
          [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "::error::tag '$TAG' is not vX.Y.Z"; exit 1; }
          bash scripts/release/release-provisioned.sh --loader .github/actions/load-secrets/action.yml @@CANDIDATE_TOKEN_ENV@@
      - name: 🔐 Load the candidate read token (candidate-ingest profile only)
        uses: ./.github/actions/load-secrets
        with:
          profile: candidate-ingest
          access_token: ${{ secrets.BWS_ACCESS_TOKEN }}
      - name: 📦 Fetch the COMPLETE published asset set
        env:
          PRODUCER_REPO: ${{ inputs.producer_repo }}
          TAG: ${{ inputs.tag }}
        run: bash scripts/release/admission-fetch.sh --repo "$PRODUCER_REPO" --tag "$TAG" --token-env @@CANDIDATE_TOKEN_ENV@@ --out candidate
#@include key-clear @@CANDIDATE_TOKEN_ENV@@
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate
          path: candidate/
          if-no-files-found: error
          retention-days: 7

  admit:
    name: 🧾 admit against the committed trust store (no secret)
    needs: fetch
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: read
    outputs:
      changed: ${{ steps.admit.outputs.changed }}
    steps:
      - name: Check out main
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate
          path: candidate
      - name: 🧾 make admit-candidate
        id: admit
        env:
          PRODUCER_REPO: ${{ inputs.producer_repo }}
          TAG: ${{ inputs.tag }}
        run: |
          set -euo pipefail
          mkdir -p out
          make admit-candidate ADMIT_CANDIDATE_DIR=candidate ADMIT_PRODUCER_REPO="$PRODUCER_REPO" ADMIT_TAG="$TAG" ADMIT_OUT=out 2>&1 | tee out/admission.log
          [ -f out/inventory.json ] || { echo "::error::make admit-candidate wrote no out/inventory.json"; exit 1; }
          if cmp -s out/inventory.json inventory/inventory.json; then
            echo "::notice::already admitted; no PR"
            echo changed=false >>"$GITHUB_OUTPUT"
          else
            echo changed=true >>"$GITHUB_OUTPUT"
          fi
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: admission
          path: |
            out/inventory.json
            out/admission.log
          if-no-files-found: error
          retention-days: 7

  open-pr:
    # RP-6/RP-7: the ONLY job that loads the admission-PR App key. It declares
    # Environment admission-pr and loads the admission-pr profile; it checks
    # out only the secret loader and the vendored blessed scripts, and commits
    # the inventory the keyless admit job produced. check-conformance.sh
    # refuses any other workflow job that declares that Environment or loads
    # that profile.
    name: 📝 open the admission PR (admission-PR App key only)
    needs: admit
    if: ${{ needs.admit.outputs.changed == 'true' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: admission-pr
    permissions:
      contents: read
    steps:
      - name: 🔒 main only
        run: |
          set -euo pipefail
          [ "$GITHUB_REF" = refs/heads/main ] || { echo "::error::admission PRs are opened from main only, not $GITHUB_REF"; exit 1; }
      - name: Check out the secret loader and the blessed scripts only
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
          sparse-checkout: |
            .github/actions/load-secrets
            scripts/bws
            scripts/release
          sparse-checkout-cone-mode: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: admission
          path: out
#@include app-token admission-pr ADMISSION_PR
      - name: 📝 Branch, commit and PR through the API
        env:
          GH_TOKEN: ${{ steps.app.outputs.token }}
          REPO: ${{ inputs.producer_repo }}
          TAG: ${{ inputs.tag }}
          SELF: ${{ github.repository }}
          BASE_SHA: ${{ github.sha }}
          INVENTORY: out/inventory.json
          ADMISSION_LOG: out/admission.log
        run: bash scripts/release/admission-open-pr.sh
