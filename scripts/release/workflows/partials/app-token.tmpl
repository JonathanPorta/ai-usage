#@ The PR-opening App token (releases.release-pr@1 RP-6/RP-7), shared by the
#@ release-PR and admission-PR jobs. Args: 1 role/profile, 2 env prefix.
      - name: 🚦 The @@1@@ App is provisioned (before any secret)
        run: bash scripts/release/release-provisioned.sh --loader .github/actions/load-secrets/action.yml @@2@@_APP_CLIENT_ID @@2@@_APP_PRIVATE_KEY
      - name: 🔐 Load the @@1@@ App (@@1@@ profile only)
        uses: ./.github/actions/load-secrets
        with:
          profile: @@1@@
          access_token: ${{ secrets.BWS_ACCESS_TOKEN }}
      # The App's own registration and installation are checked against the
      # role's declared permissions and this one repository BEFORE a token is
      # minted; the decoded key reaches only the minting step below.
      - name: 🔎 Verify the App's scope; decode its key for the minting step only
        run: bash scripts/release/app-token-prepare.sh --role @@1@@ --env-prefix @@2@@
      - name: 🎟️ Mint a token for this repository only
        id: app
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          client-id: ${{ env.@@2@@_APP_CLIENT_ID }}
          private-key: ${{ env.@@2@@_APP_PEM }}
          repositories: ${{ github.event.repository.name }}
#@include app-permissions-@@1@@
#@include key-clear @@2@@_APP_PEM @@2@@_APP_PRIVATE_KEY @@2@@_APP_CLIENT_ID
