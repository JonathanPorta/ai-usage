#@ The canonical producer release workflow (releases.release-pr@1 RP-9).
#@ Rendered by render-workflows.sh; lines starting with "#@" are template
#@ directives and never reach the output. Every product value comes from the
#@ consumer's release.yml `workflow:` block and blessed.yml; nothing here is
#@ per-product.
# GENERATED by blessed-cicd scripts/release/render-workflows.sh (release-v@@RELEASE_VERSION@@)
# from release.yml (workflow:) and blessed.yml. DO NOT EDIT: change those
# declarations and run `bash scripts/release/render-workflows.sh`;
# scripts/release/check-conformance.sh fails required CI on any difference.
name: 🚀 Release

# releases.release-pr@1 — one procedure for every producer:
#   release PR → qualified merge → secret-free build → isolated signing and
#   native finalization → complete signed candidate → verification →
#   immutable publication, which creates the tag.
#
# A push to main runs release-please, which opens or updates the release PR
# and publishes nothing (RP-1). The push that MERGES the release PR makes
# release-please create a TAGLESS DRAFT release, and this same run (RP-3)
# performs the ceremony, one job per authority, handing bytes on as
# workflow artifacts:
#
#   release-please  Environment release-pr: the release-PR App key only
#   build           no secret: `make release-build` per declared cell
#   stage           no secret: the candidate's contents and plan, fixed once
#@if rpm
#   rpm-finalize    Environment rpm-signing: the RPM key only (LP-9)
#@end
#@if derive
#   sign-artifacts  Environment release-signing: the candidate key only
#   derive          no secret: `make release-derive` adds derived files
#@end
#   sign            Environment release-signing: the candidate key only
#   verify          no secret: validated against the committed trust store
#@if lifecycle
#   lifecycle       no secret, one job per supported row (LP-6): the FINAL
#                   candidate bytes and the previous published release, each
#                   validated against the trust store, through
#                   `make release-lifecycle`
#@end
#   publish         GITHUB_TOKEN contents:write, no key: the draft becomes
#                   exactly the candidate and is published (RP-4)
#@if lifecycle
#                   — only with a passing lifecycle result for every row
#@end
#
# Every key-bearing job runs only for main at the release commit (RP-5) and
# refuses, before any secret is loaded, while its domain is unprovisioned.

on:
  push:
    branches: [main]

permissions:
  contents: read

# One release run at a time; a queued run waits and never cancels one that
# may be mid-publication.
concurrency:
  group: release
  cancel-in-progress: false

jobs:
  release-please:
    # RP-6/RP-7: the ONLY job that loads the release-PR App key. It declares
    # Environment release-pr and loads the release-pr profile; it builds,
    # packages, tests and signs nothing, and checks out only the secret loader
    # and the vendored blessed scripts. check-conformance.sh refuses any other
    # workflow job that declares that Environment or loads that profile.
    name: release-please (release-PR App key only)
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: release-pr
    permissions:
      contents: read
    outputs:
      release_created: ${{ steps.release.outputs.release_created }}
      tag_name: ${{ steps.release.outputs.tag_name }}
      version: ${{ steps.release.outputs.version }}
      sha: ${{ steps.release.outputs.sha }}
    steps:
      - name: 🔒 main only
        run: |
          set -euo pipefail
          [ "$GITHUB_REF" = refs/heads/main ] || { echo "::error::release PRs are maintained from main only, not $GITHUB_REF"; exit 1; }
      - name: Check out the secret loader and the blessed scripts only
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
          sparse-checkout: |
            .github/actions/load-secrets
            scripts/bws
            scripts/release
          sparse-checkout-cone-mode: false
#@include app-token release-pr RELEASE_PR
      - name: 🏷️ release-please (as the release-PR App)
        id: release
        uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        with:
          token: ${{ steps.app.outputs.token }}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json

  build:
    name: build ${{ matrix.cell }} (no secret)
    needs: release-please
    if: ${{ needs.release-please.outputs.release_created == 'true' }}
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 90
    permissions:
      contents: read
    strategy:
      fail-fast: true
      matrix:
        include:
#@cells
    env:
      RELEASE_CELL: ${{ matrix.cell }}
      RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
      RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
      RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
      # Read-only (contents: read): lets a product gate fetch its published
      # upgrade baseline. No secret reaches this job.
      GH_TOKEN: ${{ github.token }}
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: 🔒 The release commit is this run's commit
        shell: bash
        run: bash scripts/release/release-commit-check.sh
#@if setup
      - name: 🧰 Product toolchain (.github/actions/release-setup)
        uses: ./.github/actions/release-setup
#@end
      - name: 🧱 make release-build
        shell: bash
        run: make release-build RELEASE_CELL="$RELEASE_CELL" CANDIDATE_VERSION="$RELEASE_VERSION" CANDIDATE_TAG="$RELEASE_TAG" RELEASE_OUT="release-out/$RELEASE_CELL"
      - name: 🧮 Record the cell (declared artifacts and their digests)
        shell: bash
        run: bash scripts/release/release-cell.sh --cell "$RELEASE_CELL" --dir "release-out/$RELEASE_CELL"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: release-cell-${{ matrix.cell }}
          path: release-out/${{ matrix.cell }}/
          if-no-files-found: error
          retention-days: 3

  stage:
    # Fixes the candidate's contents ONCE: every cell's files against the
    # digests the cell recorded, the declared artifacts against the required
    # set, the public notes and the plan. Later jobs only add signatures,
    # finalization records, declared derived files and the manifest.
    name: stage the candidate (no secret)
    needs: [release-please, build]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    outputs:
      rpm_inputs: ${{ steps.stage.outputs.rpm_inputs }}
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: 🔒 The release commit is this run's commit
        env:
          RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
          RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
          RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
        run: bash scripts/release/release-commit-check.sh
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          pattern: release-cell-*
          path: cells
      - name: 🧾 Stage and plan
        id: stage
        env:
          RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
          RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
        run: |
          set -euo pipefail
          bash scripts/release/release-stage.sh --cells cells --version "$RELEASE_VERSION" --sha "$RELEASE_SHA" \
            --repo "$GITHUB_REPOSITORY" --candidate candidate --plan candidate-plan.json --rpm-inputs "$RUNNER_TEMP/rpm-inputs.json"
          echo "rpm_inputs=$(jq -c . "$RUNNER_TEMP/rpm-inputs.json")" >>"$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate-staged
          path: |
            candidate/
            candidate-plan.json
          if-no-files-found: error
          retention-days: 3
#@if rpm

  rpm-finalize:
    # LP-9: the ONLY job that loads the RPM signing key. Every check runs
    # before the key is loaded: provisioning, the RPM set, and every RPM's
    # digest against what the secret-free stage job recorded (a job output,
    # not part of the artifact it checks). The key reaches only the vendored
    # blessed rpm-finalize.sh.
    name: rpm-finalize (RPM signing key only)
    needs: [release-please, stage]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: rpm-signing
    permissions:
      contents: read
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: 🔒 main only, at the release commit, on main (RP-5)
        env:
          RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
          RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
          RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
        run: bash scripts/release/release-commit-check.sh --signing
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate-staged
          path: .
      - name: 🧰 RPM tooling (before any key)
        run: sudo apt-get update -qq && sudo apt-get install -y -qq rpm >/dev/null
      - name: 🔎 Preflight, before any key
        env:
          RPM_INPUTS: ${{ needs.stage.outputs.rpm_inputs }}
        run: |
          set -euo pipefail
          printf '%s' "$RPM_INPUTS" >"$RUNNER_TEMP/rpm-inputs.json"
          bash scripts/release/rpm-finalize-set.sh --check-only --candidate candidate --inputs "$RUNNER_TEMP/rpm-inputs.json" \
            --public-key @@RPM_PUBLIC_KEY@@ --fingerprint-file @@RPM_FINGERPRINT_FILE@@ \
            --loader .github/actions/load-secrets/action.yml --private-key-env @@RPM_KEY_ENV@@
      - name: 🔐 Load the RPM signing key (rpm-signing profile only)
        uses: ./.github/actions/load-secrets
        with:
          profile: rpm-signing
          access_token: ${{ secrets.BWS_ACCESS_TOKEN }}
      - name: ✍️ Finalize every RPM
        run: |
          bash scripts/release/rpm-finalize-set.sh --candidate candidate --inputs "$RUNNER_TEMP/rpm-inputs.json" \
            --public-key @@RPM_PUBLIC_KEY@@ --fingerprint-file @@RPM_FINGERPRINT_FILE@@ \
            --private-key-env @@RPM_KEY_ENV@@ --records rpm-finalization
#@include key-clear @@RPM_KEY_ENV@@
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate-rpm-finalized
          path: |
            candidate/
            candidate-plan.json
            rpm-finalization/
          if-no-files-found: error
          retention-days: 3
#@end
#@if derive

  sign-artifacts:
    # Signs every planned artifact, so `derive` can build on the signatures.
    name: sign-artifacts (candidate signing key only)
    needs: [release-please, @@SIGN_ARTIFACTS_AFTER@@]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: release-signing
    permissions:
      contents: read
    steps:
#@include signing-job-head @@SIGN_ARTIFACTS_INPUT@@
      - name: ✍️ Sign every planned artifact
        run: |
          bash scripts/release/release-sign.sh --stage artifacts --candidate candidate --plan candidate-plan.json \
            --private-key-env @@SIGNING_KEY_ENV@@ --private-key-encoding @@SIGNING_KEY_ENCODING@@
#@include key-clear @@SIGNING_KEY_ENV@@
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate-artifacts-signed
          path: |
            candidate/
            candidate-plan.json
          if-no-files-found: error
          retention-days: 3

  derive:
    # Product code, no secret: may ADD planned files derived from the signed
    # set; release-derive-check.sh refuses any change to an existing file.
    name: derive (no secret)
    needs: [release-please, sign-artifacts]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    env:
      RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
      RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate-artifacts-signed
          path: .
#@if setup
      - name: 🧰 Product toolchain (.github/actions/release-setup)
        uses: ./.github/actions/release-setup
#@end
      - name: 🗂️ make release-derive
        run: |
          set -euo pipefail
          bash scripts/release/release-derive-check.sh record --candidate candidate --plan candidate-plan.json --out "$RUNNER_TEMP/before.json"
          make release-derive RELEASE_CANDIDATE=candidate RELEASE_PLAN=candidate-plan.json CANDIDATE_VERSION="$RELEASE_VERSION" CANDIDATE_TAG="$RELEASE_TAG"
          bash scripts/release/release-derive-check.sh check --candidate candidate --plan candidate-plan.json --before "$RUNNER_TEMP/before.json"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate-derived
          path: |
            candidate/
            candidate-plan.json
          if-no-files-found: error
          retention-days: 3
#@end

  sign:
    # The candidate key, and only it: seals the LP-9 records, signs what the
    # declaration requires, assembles blessed/release-candidate/v1 over the
    # FINAL bytes and signs the manifest; the key is cleared before the
    # signed candidate is validated against the committed trust store.
    name: sign the candidate (candidate signing key only)
    needs: [release-please, @@SIGN_AFTER@@]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: release-signing
    permissions:
      contents: read
    steps:
#@include signing-job-head @@SIGN_INPUT@@
      - name: 🖋️ Sign, assemble and sign the manifest
        run: |
          bash scripts/release/release-sign.sh --stage final --candidate candidate --plan candidate-plan.json \
            --private-key-env @@SIGNING_KEY_ENV@@ --private-key-encoding @@SIGNING_KEY_ENCODING@@
#@include key-clear @@SIGNING_KEY_ENV@@
      - name: 🔎 Validate against the committed trust store (key already cleared)
        run: |
          bash scripts/release/validate-candidate.sh --candidate candidate/release-candidate.json --candidate-dir candidate \
            --trust-store release-trusted-keys.json --signing-dir scripts/signing
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: candidate-signed
          path: |
            candidate/
            candidate-plan.json
          if-no-files-found: error
          retention-days: 3

  verify:
    name: verify the candidate (no secret)
    needs: [release-please, sign]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    env:
      RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
      RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate-signed
          path: .
      - name: 🔎 Validate against the committed trust store only
        run: |
          bash scripts/release/validate-candidate.sh --candidate candidate/release-candidate.json --candidate-dir candidate \
            --trust-store release-trusted-keys.json --signing-dir scripts/signing
#@if verify
#@if setup
      - name: 🧰 Product toolchain (.github/actions/release-setup)
        uses: ./.github/actions/release-setup
#@end
      - name: 🔎 make release-verify
        run: make release-verify RELEASE_CANDIDATE=candidate RELEASE_PLAN=candidate-plan.json CANDIDATE_VERSION="$RELEASE_VERSION" CANDIDATE_TAG="$RELEASE_TAG"
#@end

#@if lifecycle

  lifecycle:
    # linux-packaging LP-6: the publication gate. No secret, no Environment,
    # contents: read (plus a read-only token to fetch the previous published
    # release). Runs on the FINAL bytes — after RPM finalization and signing —
    # and on the previous published release, each validated against the
    # committed trust store before the product test sees it and again after.
    # One job per declared supported row; `emulated` rows run the row's
    # platform under QEMU user emulation on this x86_64 runner (slower, and
    # their runner minutes count; the evidence level says so).
    name: lifecycle ${{ matrix.row }} (${{ matrix.evidence }}, no secret)
    needs: [release-please, sign]
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include:
#@lifecycle
    env:
      RELEASE_VERSION: ${{ needs.release-please.outputs.version }}
      RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
      RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
      GH_TOKEN: ${{ github.token }}
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: 🔒 The release commit is this run's commit
        run: bash scripts/release/release-commit-check.sh
      - name: 🧬 QEMU user emulation for ${{ matrix.platform }}
        if: matrix.qemu != 'none'
        uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0
        with:
          platforms: ${{ matrix.qemu }}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate-signed
          path: .
#@if setup
      - name: 🧰 Product toolchain (.github/actions/release-setup)
        uses: ./.github/actions/release-setup
#@end
      - name: 🔁 make release-lifecycle on the final bytes
        run: |
          bash scripts/release/release-lifecycle.sh --row "${{ matrix.row }}" --declaration release.yml \
            --candidate-dir candidate --trust-store release-trusted-keys.json --signing-dir scripts/signing \
            --repo "$GITHUB_REPOSITORY" --tag "$RELEASE_TAG" --out lifecycle-result
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: lifecycle-result-${{ matrix.row }}
          path: lifecycle-result/
          if-no-files-found: error
          retention-days: 90
#@end

  publish:
    # RP-4: the draft becomes EXACTLY the candidate, targets the release
    # commit, and only then is published, which creates the tag. A published
    # release is never modified: a re-run is an identical replay or a refusal.
    name: publish the verified draft (no key; creates the tag)
#@if lifecycle
    needs: [release-please, verify, lifecycle]
#@else
    needs: [release-please, verify]
#@end
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Check out the release commit
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ needs.release-please.outputs.sha }}
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: candidate-signed
          path: .
#@if lifecycle
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          pattern: lifecycle-result-*
          path: lifecycle-results
      - name: 🔁 Every declared row passed on THIS candidate (LP-6)
        run: |
          bash scripts/release/release-lifecycle-check.sh --declaration release.yml --results lifecycle-results \
            --candidate candidate/release-candidate.json
#@end
      - name: 🚀 Publish the verified draft (creates the tag)
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ needs.release-please.outputs.tag_name }}
          RELEASE_SHA: ${{ needs.release-please.outputs.sha }}
        run: |
          bash scripts/release/release-publish.sh --repo "$GITHUB_REPOSITORY" --tag "$RELEASE_TAG" --sha "$RELEASE_SHA" \
            --candidate-dir candidate --trust-store release-trusted-keys.json
